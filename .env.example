# Copy this file to .env and fill in your key.

# API key from https://console.typesafe.ai/keys
TYPESAFE_API_KEY=

# Price used for the cost column, in USD per 1M input tokens.
# 0.042 is the public jev-1.13 price (output tokens are free).
# Change it if your plan or the model price is different.
JEV_PRICE_PER_MILLION_INPUT_TOKENS=0.042

# Pin a model version instead of the moving "jev-latest" alias (optional).
# TYPESAFE_DEFAULT_MODEL=jev-1.13.0
